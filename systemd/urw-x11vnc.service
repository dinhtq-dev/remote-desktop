[Unit]
Description=Ubuntu Remote Web - x11vnc (DISPLAY :0, localhost only)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=VNC_PORT=5900
ExecStart=%h/Documents/source/ubuntu-remote-web/scripts/start-x11vnc.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
